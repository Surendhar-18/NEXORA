# =============================================================================
# NEXORA INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to '.env' and configure according to your operational environment.
# Never commit actual production secrets to version control.
# =============================================================================

# Server Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=true

# Host & Network
HOST=127.0.0.1
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Database Configuration (Leave empty to use default SQLite WAL mode at data/nexora.db)
DATABASE_URL=

# Upload Limits (in Megabytes)
MAX_UPLOAD_SIZE_MB=500

# Security & Authentication
# IMPORTANT: In production, generate a secure random 256-bit key using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=nexora-production-hardened-hmac-sha256-secret-key-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Access Control Enforcement
# When set to true, every sensitive endpoint strictly requires a valid JWT Bearer token.
# When set to false, unauthenticated calls fall back to standard development role permissions.
REQUIRE_AUTH=false

# Rate Limiting Controls
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# GIS Basemap Configuration (Optional)
# NEXORA defaults to Stadia Alidade Smooth Dark (keyless for local development).
# If you possess a CARTO API key or wish to override the tile provider:
# VITE_CARTO_API_KEY=your_carto_api_key_here
# VITE_MAP_TILE_URL=https://your-custom-tiles/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION="&copy; Custom Tile Attribution"
